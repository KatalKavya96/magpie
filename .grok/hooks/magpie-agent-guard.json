{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(run_terminal_command|run_terminal_cmd)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$GROK_WORKSPACE_ROOT/tools/agent-guard/src/agent_guard/__init__.py\" --grok",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
